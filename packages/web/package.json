{
  "name": "holy-grail-web",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun run scripts/build/generate-sites-index.js && bun run scripts/build/generate-extensions-index.js && bun run scripts/build/generate-mcp-index.js",
    "dev": "bun run generate && vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "generate:skills": "echo 'Skills are now loaded dynamically from skills-registry.json at runtime. Use `bun run update:registry` to refresh the community registry from known repos.'",
    "generate:extensions": "bun run scripts/build/generate-extensions-index.js",
    "generate:mcp": "bun run scripts/build/generate-mcp-index.js",
    "generate:previews": "bun run generate && bun run scripts/previews/generate-site-previews.js",
    "generate:previews:missing": "bun run generate && bun run scripts/previews/generate-site-previews.js",
    "generate:previews:all": "bun run generate && bun run scripts/previews/generate-site-previews.js --all",
    "generate:previews:refresh": "bun run generate && bun run scripts/previews/generate-site-previews.js --refresh",
    "sync:previews": "bun run scripts/build/sync-previews.js",
    "update:registry": "bun run scripts/build/update-registry.js",
    "review:previews": "python scripts/previews/review-site-previews.py",
    "import:bookmarks": "bun run scripts/enrichment/import-bookmarks.js",
    "test:mcp-mirror": "vitest run tests/mcp-search-mirror.test.ts"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@mdx-js/vue": "^3.1.1",
    "@supabase/supabase-js": "^2.112.3",
    "js-yaml": "^4.2.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.0",
    "pinia": "^3.0.4",
    "posthog-js": "^1.418.10",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "happy-dom": "^20.11.6",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.26",
    "puppeteer-core": "^25.8.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "24.x"
  }
}
