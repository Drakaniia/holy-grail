{
  "name": "holy-grail",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "bun run generate && turbo run build",
    "preview": "bun run --cwd packages/web preview",
    "type-check": "turbo run type-check",
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli packages/web/src/ packages/web/scripts/ packages/web/public/content/ packages/supabase/functions/ .github/ packages/mcp/src/ packages/mcp/evals/ packages/mcp/scripts/ packages/web/vite.config.ts packages/web/postcss.config.js eslint.config.js",
    "format:check": "prettier --check --experimental-cli packages/web/src/ packages/web/scripts/ packages/web/public/content/ packages/supabase/functions/ .github/ packages/mcp/src/ packages/mcp/evals/ packages/mcp/scripts/ packages/web/vite.config.ts packages/web/postcss.config.js eslint.config.js",
    "setup": "git submodule update --init --recursive && git config core.hooksPath .githooks",
    "sync:previews": "bun run --cwd packages/web sync:previews",
    "update:registry": "bun run --cwd packages/web update:registry",
    "generate": "bun run --cwd packages/web generate",
    "generate:skills": "bun run --cwd packages/web generate:skills",
    "generate:extensions": "bun run --cwd packages/web generate:extensions",
    "generate:mcp": "bun run --cwd packages/web generate:mcp",
    "generate:previews": "bun run --cwd packages/web generate:previews",
    "generate:previews:missing": "bun run --cwd packages/web generate:previews:missing",
    "generate:previews:all": "bun run --cwd packages/web generate:previews:all",
    "generate:previews:refresh": "bun run --cwd packages/web generate:previews:refresh",
    "review:previews": "cd packages/web && python scripts/previews/review-site-previews.py",
    "build:cli": "bun run --cwd packages/cli build:release",
    "build:mcp": "bun run --cwd packages/mcp build",
    "test:mcp-search": "bun test packages/mcp/evals/search-corpus.test.ts",
    "test:mcp-mirror": "bun run --cwd packages/web test:mcp-mirror",
    "test:mcp-evals": "bun packages/mcp/evals/run-evals.ts",
    "import:bookmarks": "bun run --cwd packages/web import:bookmarks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.78.0",
    "eslint-plugin-vue": "~10.10.0",
    "globals": "^17.11.0",
    "oxlint": "~1.78.0",
    "prettier": "3.9.6",
    "turbo": "^2",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": "24.x"
  }
}
