{
  "name": "holy-grail",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/build/generate-sites-index.js && bun run scripts/build/generate-extensions-index.js && bun run scripts/build/generate-mcp-index.js && vite",
    "build": "bun run scripts/build/generate-sites-index.js && bun run scripts/build/generate-extensions-index.js && bun run scripts/build/generate-mcp-index.js && vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/ scripts/ public/content/ supabase/functions/ .github/ vite.config.ts postcss.config.js eslint.config.js",
    "format:check": "prettier --check --experimental-cli src/ scripts/ public/content/ supabase/functions/ .github/ vite.config.ts postcss.config.js eslint.config.js",
    "update:registry": "bun run scripts/build/update-registry.js",
    "generate:skills": "echo 'Skills are now loaded dynamically from skills-registry.json at runtime. Use `bun run update:registry` to refresh the community registry from known repos.'",
    "generate:extensions": "bun run scripts/build/generate-extensions-index.js",
    "generate:mcp": "bun run scripts/build/generate-mcp-index.js",
    "generate:previews": "bun run scripts/build/generate-sites-index.js && bun run scripts/previews/generate-site-previews.js",
    "generate:previews:missing": "bun run scripts/build/generate-sites-index.js && bun run scripts/previews/generate-site-previews.js",
    "generate:previews:all": "bun run scripts/build/generate-sites-index.js && bun run scripts/previews/generate-site-previews.js --all",
    "generate:previews:refresh": "bun run scripts/build/generate-sites-index.js && bun run scripts/previews/generate-site-previews.js --refresh",
    "review:previews": "python scripts/previews/review-site-previews.py",
    "build:cli": "tsc -p cli/tsconfig.json && cd cli && cargo build --release",
    "import:bookmarks": "bun run scripts/enrichment/import-bookmarks.js"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@mdx-js/vue": "^3.1.1",
    "@supabase/supabase-js": "^2.112.2",
    "js-yaml": "^4.2.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.3.0",
    "pinia": "^4.0.2",
    "posthog-js": "^1.414.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/node22": "^22.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.77.0",
    "eslint-plugin-vue": "~10.10.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.77.0",
    "postcss": "^8.5.25",
    "prettier": "3.9.6",
    "puppeteer-core": "^25.5.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": "24.x"
  }
}
