{
  "name": "holy-grail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/generate-skills-index.js && bun run scripts/generate-sites-index.js && vite",
    "build": "bun run scripts/generate-skills-index.js && bun run scripts/generate-sites-index.js && vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "generate:skills": "bun run scripts/generate-skills-index.js",
    "generate:previews": "bun run scripts/generate-sites-index.js && bun run scripts/generate-site-previews.js",
    "generate:previews:missing": "bun run scripts/generate-sites-index.js && bun run scripts/generate-site-previews.js",
    "generate:previews:all": "bun run scripts/generate-sites-index.js && bun run scripts/generate-site-previews.js --all",
    "import:bookmarks": "bun run scripts/import-bookmarks.js"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@mdx-js/rollup": "^3.1.1",
    "@mdx-js/vue": "^3.1.1",
    "@supabase/supabase-js": "^2.107.0",
    "js-yaml": "^4.1.1",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.2.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.66.0",
    "eslint-plugin-vue": "~10.9.1",
    "globals": "^17.6.0",
    "npm-run-all2": "^9.0.1",
    "oxlint": "~1.68.0",
    "postcss": "^8.5.15",
    "prettier": "3.8.3",
    "puppeteer-core": "^25.0.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^3.3.2"
  },
  "engines": {
    "node": "24.x"
  }
}
